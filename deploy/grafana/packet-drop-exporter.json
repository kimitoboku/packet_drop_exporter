{
  "annotations": {"list": []},
  "description": "Linux skb drop reasons, locations, capacity, and exporter health.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "min(packet_drop_exporter_ready)", "refId": "A"}],
      "title": "Exporter Ready",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "orange", "value": 0.8}, {"color": "red", "value": 0.95}]}, "unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 4, "w": 8, "x": 4, "y": 0},
      "id": 2,
      "options": {"minVizHeight": 75, "minVizWidth": 75, "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showThresholdLabels": false, "showThresholdMarkers": true, "sizing": "auto"},
      "targets": [{"expr": "packet_drop_exporter_bpf_map_entries / packet_drop_exporter_bpf_map_max_entries", "legendFormat": "{{instance}}", "refId": "A"}],
      "title": "BPF Map Utilization",
      "type": "gauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "showPoints": "never", "spanNulls": false}, "unit": "pps"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 4},
      "id": 3,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "topk(20, sum by (reason, location) (rate(linux_skb_drops_total[$__rate_interval])))", "legendFormat": "{{reason}} at {{location}}", "refId": "A"}],
      "title": "Top skb Drop Rates",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "showPoints": "never", "spanNulls": false}, "unit": "Bps"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 4},
      "id": 4,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "topk(20, sum by (reason, location) (rate(linux_skb_drop_bytes_total[$__rate_interval])))", "legendFormat": "{{reason}} at {{location}}", "refId": "A"}],
      "title": "Top skb Drop Byte Rates",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 5, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "showPoints": "never", "spanNulls": false}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 13},
      "id": 5,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "packet_drop_exporter_snapshot_age_seconds", "legendFormat": "{{instance}} snapshot age", "refId": "A"}, {"expr": "packet_drop_exporter_collection_duration_seconds", "legendFormat": "{{instance}} collection duration", "refId": "B"}],
      "title": "Collection Freshness and Duration",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 5, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "showPoints": "never", "spanNulls": false}, "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 13},
      "id": 6,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "rate(packet_drop_exporter_map_update_failures_total[$__rate_interval])", "legendFormat": "{{instance}} map", "refId": "A"}, {"expr": "rate(packet_drop_exporter_collection_failures_total[$__rate_interval])", "legendFormat": "{{instance}} collection", "refId": "B"}, {"expr": "rate(packet_drop_exporter_symbol_refresh_failures_total[$__rate_interval])", "legendFormat": "{{instance}} symbol refresh", "refId": "C"}],
      "title": "Exporter Failure Rates",
      "type": "timeseries"
    }
  ],
